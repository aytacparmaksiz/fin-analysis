# Google Gemini API Anahtarınız
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Bulut Veritabanı (Opsiyonel - Cihazlar arası senkronizasyon için)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
